// token.shl — an ERC-20-style fungible token in the Solidity-like SHL dialect.
//
// No magic numbers: `state` vars get compiler-assigned slots; `balances` is a
// mapping keyed by holder. Calls carry calldata word 0 = Selector("<fn>") and
// the args in the following words; the compiler emits the selector dispatcher.
//
//   init()                 one-time mint of the whole supply to the caller
//   transfer(to, amount)   move `amount` to `to`        -> reverts if short
//   balanceOf(who)         read a balance
//   supply()               read total supply
//
// Arithmetic is overflow-checked (Solidity 0.8 semantics) and `require` reverts
// — a failed transfer undoes everything, it is not a silent no-op.

state balances;
state totalSupply;
state initialized;

fn init() {
    require(initialized == 0);
    initialized = 1;
    balances[caller()] = 1000000;
    totalSupply = 1000000;
    emit(0, caller(), 1000000);              // Mint(to, amount)
}

fn transfer(to, amount) {
    require(balances[caller()] >= amount);
    balances[caller()] = balances[caller()] - amount;
    balances[to] = balances[to] + amount;    // self-transfer nets to zero (same slot)
    emit(1, caller(), to, amount);           // Transfer(from, to, amount)
}

fn balanceOf(who) {
    return balances[who];
}

fn supply() {
    return totalSupply;
}
