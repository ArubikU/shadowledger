// nft.shl — a minimal ERC-721-style NFT in the Solidity-like SHL dialect.
//
//   mint(tokenId)         claim an unowned token id           -> reverts if taken
//   transfer(tokenId, to) move a token you own                -> reverts if not owner
//   ownerOf(tokenId)      read the owner (caller-id digest)
//
// `owner` is a mapping tokenId -> owner-id. Owner is the caller's uint64 digest
// (full-address recovery uses the VM byte layer; see docs/SMART-CONTRACTS.md).

state owner;

fn mint(tokenId) {
    require(owner[tokenId] == 0);            // unowned (0 = no owner)
    owner[tokenId] = caller();
    emit(0, caller(), tokenId);              // Transfer(mint): [sig=0, to, tokenId]
}

fn transfer(tokenId, to) {
    require(owner[tokenId] == caller());     // only the owner may move it
    owner[tokenId] = to;
    emit(1, caller(), to, tokenId);          // Transfer: [sig=1, from, to, tokenId]
}

fn ownerOf(tokenId) {
    return owner[tokenId];
}
