// memecoin.shl — a fixed-supply meme coin with burn, Solidity-like SHL dialect.
// "SHADOWMEME": 21,000,000 units minted once to the deployer; burning lowers
// the total supply for good.
//
//   init()                 one-time mint of the fixed supply to the caller
//   transfer(to, amount)   move coins                         -> reverts if short
//   burn(amount)           destroy your coins (cuts supply)   -> reverts if short
//   balanceOf(who)         read a balance
//   supply()               read remaining supply

state balances;
state totalSupply;
state initialized;

fn init() {
    require(initialized == 0);
    initialized = 1;
    balances[caller()] = 21000000;
    totalSupply = 21000000;
    emit(0, caller(), 21000000);             // Mint
}

fn transfer(to, amount) {
    require(balances[caller()] >= amount);
    balances[caller()] = balances[caller()] - amount;
    balances[to] = balances[to] + amount;
    emit(1, caller(), to, amount);           // Transfer
}

fn burn(amount) {
    require(balances[caller()] >= amount);
    balances[caller()] = balances[caller()] - amount;
    totalSupply = totalSupply - amount;
    emit(2, caller(), amount);               // Burn
}

fn balanceOf(who) {
    return balances[who];
}

fn supply() {
    return totalSupply;
}
