// memecoin.shl — a fixed-supply meme coin with burn. ERC-20-style, keyed by
// address digest. "SHADOWMEME": 21,000,000 units minted once to the deployer.
//
// arg(0)=selector, arg(1)=recipient/address, arg(2)=amount
//   0 = init        : one-time mint of fixed supply to caller
//   1 = transfer    : send arg(2) to arg(1)
//   2 = balanceOf   : return balance of arg(1)
//   3 = burn        : destroy arg(2) of caller's coins (reduces total supply)
//   4 = totalSupply : return remaining supply
//
// Reserved keys: ...615 = initialized, ...614 = totalSupply.

if (arg(0) == 0) {
    if (store[18446744073709551615] == 0) {
        store[18446744073709551615] = 1;
        store[caller()] = 21000000;
        store[18446744073709551614] = 21000000;
        emit(0, caller(), 21000000);            // Mint
    }
} else {
    if (arg(0) == 1) {                          // transfer
        if (store[caller()] >= arg(2)) {
            store[caller()] = store[caller()] - arg(2);
            store[arg(1)] = store[arg(1)] + arg(2);
            emit(1, caller(), arg(1), arg(2));  // Transfer
        } else { return 0; }
    } else {
        if (arg(0) == 2) {
            return store[arg(1)];               // balanceOf
        } else {
            if (arg(0) == 3) {                  // burn(amount=arg2)
                if (store[caller()] >= arg(2)) {
                    store[caller()] = store[caller()] - arg(2);
                    store[18446744073709551614] = store[18446744073709551614] - arg(2);
                    emit(2, caller(), arg(2));  // Burn
                } else { return 0; }
            } else {
                return store[18446744073709551614]; // totalSupply
            }
        }
    }
}
